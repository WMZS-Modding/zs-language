{
  "name": "zs-language",
  "displayName": "ZS Language",
  "description": "An extension that helps clarify the codes of the ZS language",
  "version": "0.1.4",
  "publisher": "SuperHero2010",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/WMZS-Modding/zs-language/issues"
  },
  "homepage": "https://github.com/WMZS-Modding/zs-language",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WMZS-Modding/zs-language.git"
  },
  "keywords": [
    "zs-language",
    "game-development",
    "english-like",
    "syntax-highlighting",
    "programming-language",
    "vscode-extension"
  ],
  "icon": "icons/zs-logo-6.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zs",
        "aliases": [
          "ZS",
          "zs"
        ],
        "extensions": [
          ".zs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zs",
        "scopeName": "source.zs",
        "path": "./syntaxes/zs.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.104.0",
    "typescript": "^5.9.2"
  }
}
