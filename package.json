{
  "name": "zs-language",
  "displayName": "ZS Language",
  "description": "An extension that helps clarify the codes of the ZS language",
  "version": "1.3.6",
  "publisher": "SuperHero2010",
  "license": "MIT or GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/WMZS-Modding/zs-language/issues"
  },
  "homepage": "https://github.com/WMZS-Modding/zs-language",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WMZS-Modding/zs-language.git"
  },
  "keywords": [
    "zs-language",
    "game-development",
    "english-like",
    "syntax-highlighting",
    "programming-language",
    "vscode-extension"
  ],
  "icon": "icons/zs-logo-6.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zs",
        "aliases": [
          "ZS",
          "zs"
        ],
        "extensions": [
          ".zs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zs",
        "scopeName": "source.zs",
        "path": "./syntaxes/zs.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "ZS Dark Modern",
        "uiTheme": "vs-dark",
        "path": "./themes/zs-dark-modern.json"
      },
      {
        "label": "ZS Light Modern",
        "uiTheme": "vs",
        "path": "./themes/zs-light-modern.json"
      },
      {
        "label": "ZS Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zs-dark.json"
      },
      {
        "label": "ZS Dark Default",
        "uiTheme": "vs-dark",
        "path": "./themes/zs-dark-default.json"
      },
      {
        "label": "ZS Light",
        "uiTheme": "vs",
        "path": "./themes/zs-light.json"
      },
      {
        "label": "ZS Light Default",
        "uiTheme": "vs",
        "path": "./themes/zs-light-default.json"
      },
      {
        "label": "ZS Dark High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/zs-dark-high-contrast.json"
      },
      {
        "label": "ZS Light High Contrast",
        "uiTheme": "hc-light",
        "path": "./themes/zs-light-high-contrast.json"
      }
    ],
    "commands": [
      {
        "command": "zs.selectMathSign",
        "title": "ZS: Select Math Sign",
        "category": "ZS"
      }
    ],
    "keybindings": [
      {
        "command": "zs.selectMathSign",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorTextFocus && editorLangId == zs"
      }
    ],
    "configurationDefaults": {
      "[zs]": {
        "editor.formatOnType": true,
        "editor.autoIndent": "none"
      }
    },
    "semanticTokenTypes": [
      {
        "id": "module",
        "superType": "namespace",
        "description": "Imported module names"
      },
      {
        "id": "alias",
        "superType": "variable",
        "description": "Module aliases"
      },
      {
        "id": "keyword",
        "superType": "keyword",
        "description": "Import keywords"
      }
    ],
    "semanticTokenModifiers": []
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/vscode": "^1.104.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fs": "^0.0.1-security",
    "path": "^0.12.7"
  }
}
