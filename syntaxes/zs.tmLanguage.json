{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZS",
  "scopeName": "source.zs",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#block-comments" },
    { "include": "#numbers" },
    { "include": "#class-name" },
    { "include": "#invalidGrammar" },
    { "include": "#tilemap-noun"},
    { "include": "#function-noun" },
    { "include": "#script-noun" },
    { "include": "#language-type" },
    { "include": "#function" },
    { "include": "#for-repeater" },
    { "include": "#imports" },
    { "include": "#specialverbs" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zs",
          "match": "(?i)\\b(when|if|then|else|with|while|done|trigger|except|once|twice|f?r?o?z?e?n?set|before|after|assert|async|await|break|continue|finally|pass|raise|return|try|yield)\\b"
        },
        {
          "name": "entity.name.type.zs",
          "match": "(?i)\\b(public|private|range|float|int|str|complex|list|tuple|dict|bool|type|bytes|bytearray|classmethod|staticmethod|super|zip)\\b"
        },
        {
          "name": "variable.language.zs",
          "match": "(?i)\\b(itself|and|monobehaviour|unitysystem|uievent|unityengine|it|they|them|themself|true|false|f|none|n?o?n?local|globals?|lambda|not|or|id|iter|len|locals|map|memoryview|object|oct|ord|repr|round|static)\\b"
        },
        {
          "name": "invalid.illegal.zs",
          "match": "(?i)\\b(am|was|were|had|has|have|may|might|must|shall|should|would|could|did|being|been|feels?|loves?|hates?|dislikes?|likes?|prefer|wish|want|know|understand|believe|think|remember|forget|own|possess|belong|see|hear|smell|taste|be|seem|appear|look|disappear|care|become|grow|stay|remain|will|can)\\b"
        },
        {
          "name": "markup.inserted.zs",
          "match": "(?i)\\b(move|run|play|touch|cut|earse|wait|does|blow|is|are|flow|load|calla?b?l?e?|stop|delete|destroy|remove|replace|clear|copy|add|count|extend|r?index|insert|popi?t?e?m?|reversed?|sort|append|s?y?m?m?e?t?r?i?c?_?difference_?u?p?d?a?t?e?|discard|intersection_?u?p?d?a?t?e?|isdisjoint|issubset|issuperset|union|update|fromkeys|get|items|keys|setdefault|values|capitalize|casefold|center|encode|endswith|expandtabs|r?find|format_?m?a?p?|isalnum|isalpha|isascii|isdecimal|isdigit|isidentifier|i?s?lower|isnumeric|isprintable|isspace|i?s?title|i?s?upper|join|ljust|lstrip|maketrans|r?partition|removeprefix|removesuffix|rjust|rsplit|r?strip|splitl?i?n?e?s?|starts?w?i?t?h?|swapcase|translate|zfill|filter|help|isinstance|issubclass|open|sorted|slice)\\b"
        },
        {
          "name": "entity.name.function.zs",
          "match": "(?i)\\b(abs|aiter|all|any|anext|ascii|bin|breakpoint|chr|compile|delattr|dir|divmod|enumerate|eval|exec|getattr|hasattr|hash|hex|min|max|next|setattr|sum|vars|__import__)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zs",
          "begin": "“",
          "end": "”",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zs",
          "begin": "‘",
          "end": "’",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.slashdash.zs",
          "begin": "-/",
          "end": "$"
        }
      ]
    },
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.zs",
          "begin": "\\*/-",
          "end": "/-\\*",
          "patterns": [
            {
              "match": ".",
              "name": "comment.block.content.zs"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.zs",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "class-name": {
      "patterns": [
        {
          "name": "meta.class.zs",
          "begin": "(?i)\\b(class|prefab)\\b\\s+",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.class.zs"
            }
          },
          "end": "(?=\\{|:|\\s|$)",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "keyword.declaration.zs"
            }
          ]
        }
      ]
    },
    "invalidGrammar": {
      "patterns": [
        {
          "name": "invalid.illegal.zs",
          "match": "(?i)\\b(i|you|he|she|we|us|me|him|hers?|ours?|his|your|my|mine|theirs?|its|myself|yourself|himself|herself|ourself|ourselves|yourselves|myselves|himselves|herselves|themselves|itselves)\\b"
        }
      ]
    },
    "tilemap-noun": {
      "patterns": [
        {
          "name" : "support.function.tilemap.zs",
          "match": "/\\|[^|\\\\\\n]+\\|\\\\"
        }
      ]
    },
    "function-noun": {
      "patterns": [
        {
          "name": "support.function.noun.zs",
          "match": "<[^<>\\n]+>"
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "support.function.zs",
          "match": "\\b(\\w+):"
        }
      ]
    },
    "for-repeater": {
      "patterns": [
        {
          "name": "keyword.control.for.zs",
          "begin": "(?i)\\b(for)\\b\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.zs"
            }
          },
          "end": "(?i)\\b(in|do)\\b",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "entity.name.variable.zs"
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.from.zs",
          "match": "\\b(from)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.from.zs" },
            "2": { "name": "entity.name.type.path.zs" }
          }
        },
        {
          "name": "meta.import.zs",
          "match": "\\b(import)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.import.zs" },
            "2": { "name": "entity.name.type.module.zs" }
          }
        },
        {
          "name": "meta.import-alias.zs",
          "match": "\\b(as)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.as.zs" },
            "2": { "name": "entity.name.type.other.redwrite.zs" }
          }
        }
      ]
    },
    "specialverbs": {
      "patterns": [
        {
          "name": "invalid.illegal.zs",
          "match": "(?i)\\b\\w+(ed|ing)\\b"
        }
      ]
    },
    "language-type": {
      "patterns": [
        {
          "name": "keyword.other.language-type.zs",
          "match": "^\\!\\s*(ZS-CSHARP|ZS-LUA|ZS-PYTHON|ZS-NORMAL)\\b"
        }
      ]
    }
  },
  "uuid": "4d1eb976-65c1-4039-bbc1-97b7eb5d7b2a"
}