{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZS",
  "scopeName": "source.zs",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#block-comments" },
    { "include": "#numbers" },
    { "include": "#class-name" },
    { "include": "#invalidGrammar" },
    { "include": "#tilemap-noun"},
    { "include": "#function-noun" },
    { "include": "#script-noun" },
    { "include": "#language-type" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zs",
          "match": "(?i)\\b(when|if|then|else|with|while|done|trigger|except|once|twice|set|before|after|local|for)\\b"
        },
        {
          "name": "entity.name.type.zs",
          "match": "(?i)\\b(public|private)\\b"
        },
        {
          "name": "variable.language.zs",
          "match": "(?i)\\b(itself|and|monobehaviour|unitysystem|uievent|unityengine|it|they|them|themself|true|false)\\b"
        },
        {
          "name": "invalid.illegal.zs",
          "match": "(?i)\\b(am|was|were|had|has|have|may|might|must|shall|should|would|could|did|being|been|feels?|loves?|hates?|dislikes?|likes?|prefer|wish|want|need|know|understand|believe|think|remember|forget|own|possess|belong|see|hear|smell|taste|be|seem|appear|look|disappear|care|become|get|grow|stay|remain|will|can)\\b"
        },
        {
          "name": "markup.inserted.zs",
          "match": "(?i)\\b(move|run|play|touch|cut|earse|wait|doe?s?|blow|is|are|flow|load|call|stop|delete|destroy|remove|replace)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zs",
          "begin": "“",
          "end": "”",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zs",
          "begin": "‘",
          "end": "’",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.slashdash.zs",
          "begin": "-/",
          "end": "$"
        }
      ]
    },
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.zs",
          "begin": "\\*/-",
          "end": "/-\\*",
          "patterns": [
            {
              "match": ".",
              "name": "comment.block.content.zs"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.zs",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "class-name": {
      "patterns": [
        {
          "name": "meta.class.zs",
          "begin": "(?i)\\b(class|prefab)\\b\\s+",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.class.zs"
            }
          },
          "end": "(?=\\{|:|\\s|$)",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "keyword.declaration.zs"
            }
          ]
        }
      ]
    },
    "invalidGrammar": {
      "patterns": [
        {
          "name": "invalid.illegal.zs",
          "match": "(?i)\\b(i|you|he|she|we|us|me|him|hers?|ours?|his|your|my|mine|theirs?|its|myself|yourself|himself|herself|ourself|ourselves|yourselves|myselves|himselves|herselves|themselves|itselves)\\b"
        }
      ]
    },
    "tilemap-noun": {
      "patterns": [
        {
          "name" : "support.function.tilemap.zs",
          "match": "/\\|[^|\\\\\\n]+\\|\\\\"
        }
      ]
    },
    "function-noun": {
      "patterns": [
        {
          "name": "support.function.noun.zs",
          "match": "<[^<>\\n]+>"
        }
      ]
    },
    "script-noun": {
      "patterns": [
        {
          "name": "support.function.script.zs",
          "match": "\\([^()\\n]+\\)"
        }
      ]
    },
    "language-type": {
      "patterns": [
        {
          "name": "keyword.other.language-type.zs",
          "match": "^\\!\\s*(ZS-CSHARP|ZS-LUA)\\b"
        }
      ]
    }
  },
  "uuid": "4d1eb976-65c1-4039-bbc1-97b7eb5d7b2a"
}