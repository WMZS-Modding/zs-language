{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZS",
  "scopeName": "source.zs",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#block-comments" },
    { "include": "#numbers" },
    { "include": "#class-name" },
    { "include": "#invalidGrammar" },
    { "include": "#tilemap-noun"},
    { "include": "#function-noun" },
    { "include": "#script-noun" },
    { "include": "#module-usage" },
    { "include": "#language-type" },
    { "include": "#function" },
    { "include": "#specialwords" },
    { "include": "#preprocessor"},
    { "include": "#prepositions" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zs",
          "match": "(?i)\\b(when|if|then|unless|else|for|in|from|import|give|back|nothing|while|done|trigger|do|except|once|twice|attempt|handle|ensure|report|repeat|stream|f?r?o?z?e?n?set|before|after|assert|async|break|continue|each|proceed|halt|haltLua|haltScript|haltAll|change|read|uniform|add|remove|create|name|cancel|any|matrix|indicies?)\\b"
        },
        {
          "name": "entity.name.type.zs",
          "match": "(?i)\\b(public|private|range|class|floatA?r?r?a?y?|intA?r?r?a?y?|str|complex|list|tuple|dict|boolA?r?r?a?y?|type|bytes|bytearray|classmethod|staticmethod|super|zip|sampler2D|grid)\\b"
        },
        {
          "name": "variable.language.zs",
          "match": "(?i)\\b(itself|new|monobehaviour|unitysystem|uievent|unityengine|it|they|them|themself|true|false|f|n?o?n?local|globals?|lambda|not|or|id|iter|len|locals|map|memoryview|object|oct|ord|repr|round|undo|redo|template|data|code|library|event|value|variable|argument|notes?|loops?|package)\\b"
        },
        {
          "name": "zs.red.zs",
          "match": "(?i)\\b(am|was|were|had|has|have|may|must|shall|should|would|could|did|being|been|feels?|loves?|hates?|dislikes?|likes?|prefers?|wishe?s?|wants?|knows?|believes?|thinks?|remembers?|own|possesse?s?|belongs?|smells?|tastes?|be|seems?|looks?|d?i?s?appears?|cares?|b?e?comes?|stays?|remains?|will|can|abides?|abode|arises?|arose|a?wakes?|a?woke|backslide?s?|f?o?r?bears?|f?o?r?bore|f?o?r?borne|b?r?o?w?beats?|b?e?came|b?e?falls?|b?e?fell|began|begun|b?e?holds?|b?e?held|bends?|bent|besets?|b?e?speaks?|b?e?spoke|bets?|bids?|binds?|bound|bite?s?|blee?ds?|blew|blown|broke|i?n?bree?ds?|brings?|broadcasts?|builds?|built|burnt|bur?st|buys?|f?o?r?e?casts?|catchs?|chide?|chose|clove|cleft|clave|clings?|clung|clothes?|clad|costs?|creeps?|crept|crossbree?ds?|crows?|crew|d?a?y?dreams|d?a?y?dreamt?|deals|dealt?|dug|disproves?|dove|drew|drawn|drinks?|drank|drunk|drives?|drove|dwells?|dwelt|eats?|ate|fee?ds?|felt|found|fits?|flees?|flings?|flung|flew|flown|forbids?|forbade?|f?o?r?e?goe?s?|f?o?r?e?went|f?o?r?e?gone|f?o?r?e?sees?|f?o?r?e?saw|f?o?r?e?tell|f?o?r?e?told|f?o?r?gets?|f?o?r?got|forgive|forgives|f?o?r?gave|forsakes?|forsook|froze|frostbites?|frostbit|gilds?|gilt|girds?|girt|gives|grinds?|ground|grew|grown|hand-fee?ds?|handwrites?|h?a?n?d?wrote|hangs?|hung|heard|heaves?|hove|hews?|hewn|hid|i?n?lays?|i?n?laid|insets?|interbree?ds?|i?n?t?e?r?weaves?|i?n?t?e?r?wove|i?n?t?e?r?winds?|i?n?t?e?r?wound|jerry-builds?|jerry-built|kept|kneels?|knelt|knit|knew|known|leads?|led|leans?|leant|leaps?|leapt|learnt|lends?|lent|lies?|lain|lit|lip-reads?|lost|makes?|made|means?|meant|mee?ts?|mows?|mown|parktakes?|partook|pays?|paid|pleads?|pled|proofreads?|proves?|proven|quick-freezes?|quick-froze|rids?|rides?|rode|rings?|rang|rung|rises?|rose|roughcast|ran|sand-cast|saws?|sawn|says?|said|seeks?|sells?|sold|sends?|sent|sews?|sewn|shook|shaves?|shears?|shorn|sheds?|shines?|shone|shits?|shat|shown|shrinks?|shrank|shrunk|shut|sight-reads?|sang|sung|sinks?|sank|sunk|sits?|sat|slays?|slew|slain|slept|slides?|slid|slings?|slung|slinks?|slunk|slits?|smelt|smites?|smote|sneaks?|snuck|sped|spells?|spelt|spends?|spent|spills?|spilt|spins?|span|spun|spoils?|spoilt|spreads?|stands?|stood|steals?|stole|sticks?|stuck|stings?|stung|stinks?|stank|stunk|strides?|strode|strikes?|struck|strung|sunburns?|sunburnt|s?wears?|s?wore|s?worn|sweats?|swept|swells?|swims?|swam|swum|swings?|swung|takes?|took|teache?s?|tears?|tore|torn|telecasts?|throws?|threw|thrown|thrusts?|treads?|trod|typewrites?|typewrote|upholds?|upheld|weds?|weeps?|wept|wets?|won|withdraws?|withdrew|withdrawn|withholds?|withheld|withstands?|withstood|works?|wrings?|wrung)\\b"
        },
        {
          "name": "zs.green.zs",
          "match": "(?i)\\b(moves?|runs?|plays?|touche?s?|cuts?|earses?|waite?s?|does|blows?|is|are|flows?|loads?|calla?b?l?e?|calls|stops?|deletes?|destroys?|removes|replaces?|clear|copy|copies|adds|creates|count|extends?|r?index|insert|popi?t?e?m?|reverses?|sort|append|s?y?m?m?e?t?r?i?c?_?difference_?u?p?d?a?t?e?|discard|intersection_?u?p?d?a?t?e?|isdisjoint|issubset|issuperset|union|updates?|fromkeys|gets?|items|keys|setdefault|values|capitalize|casefold|center|encode|endswith|expandtabs|r?find|format_?m?a?p?|isalnum|isalpha|isascii|isdecimal|isdigit|isidentifier|i?s?lower|isnumeric|isprintable|isspace|i?s?title|i?s?upper|join|ljust|lstrip|maketrans|r?partition|removeprefix|removesuffix|rjust|rsplit|r?strip|splitl?i?n?e?s?|starts?w?i?t?h?|swapcase|translate|zfill|filter|help|isinstance|issubclass|opens?|slices?|complement|emptyset|elementof|p?r?o?p?e?r?subset|infinity|attacks?|burns?|chooses?|cleaves?|digs?|dives?|draws?|fights?|finds?|fly|flies|freezes?|grows?|hears?|hides?|hit|hurt|keeps?|learns?|lets?|puts?|reads|shakes?|shoots?|shows?|sings?|sleeps?|speeds?|sweeps?|writes?|wins?|loses?|exits?|exists?|skips?|leaves?|resumes?|produces?|matche?s?|verify|verifies|closes?|writes?|overrides?|overwrites?|arranges?|rearranges?|invert|register|apply|tween|resets?|restarts?|scales?|pauses?|follow|zoom|flush|flushes|erases?|miss|misses|saves?)\\b"
        },
        {
          "name": "entity.name.function.zs",
          "match": "(?i)\\b(abs|aiter|all|any|anext|ascii|bin|breakpoint|chr|compile|delattr|dir|divmod|enumerate|eval|exec|getattr|hasattr|hash|hex|min|max|setattr|sum|vars|__import__)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zs",
          "begin": "“",
          "end": "”",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zs",
          "begin": "‘",
          "end": "’",
          "patterns": [
            {
              "name": "constant.character.escape.zs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.slashdash.zs",
          "begin": "-/",
          "end": "$"
        }
      ]
    },
    "block-comments": {
      "patterns": [
        {
          "name": "comment.block.zs",
          "begin": "\\*/-",
          "end": "/-\\*",
          "patterns": [
            {
              "match": ".",
              "name": "comment.block.content.zs"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.zs",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "class-name": {
      "patterns": [
        {
          "name": "meta.class.zs",
          "begin": "(?i)\\b(prefab)\\b\\s+",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.class.zs"
            }
          },
          "end": "(?=\\{|:|\\s|$)",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "keyword.declaration.zs"
            }
          ]
        }
      ]
    },
    "invalidGrammar": {
      "patterns": [
        {
          "name": "zs.red.zs",
          "match": "(?i)\\b(i|you|he|she|we|us|me|him|hers?|ours?|his|your|my|mine|theirs?|its|myself|yourself|himself|herself|ourself|ourselves|yourselves|myselves|himselves|herselves|themselves|itselves|none|null|nil|nullptr|await|finally|pass|raise|return|try|yield)\\b"
        }
      ]
    },
    "tilemap-noun": {
      "patterns": [
        {
          "name" : "zs.blue.tilemap.zs",
          "match": "/\\|[^|\\\\\\n]+\\|\\\\"
        },
        {
          "name" : "zs.yellow.abs.zs",
          "match": "\\|[^|\\\\\\n]+\\|"
        }
      ]
    },
    "function-noun": {
      "patterns": [
        {
          "name": "zs.blue.noun.zs",
          "match": "<[^<>\\n]+>"
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "support.function.zs",
          "match": "\\b(\\w+):"
        }
      ]
    },
    "module-usage": {
      "patterns": [
        {
          "name": "meta.module-usage.zs",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.module.zs" },
            "2": { "name": "entity.name.function.zs" }
          }
        }
      ]
    },
    "specialwords": {
      "patterns": [
        {
          "name": "zs.red.zs",
          "match": "(?i)\\b(?!(elapsed|onEventPushed|onTweenCompleted|onTimerCompleted|onSoundFinished|onRecalculateRating|onCountdownStarted|then|tween|animated?|clicked|pressed|released|between|rating|running|height)\\b)\\w+(ed|ing|en|ght)\\b"
        },
        {
          "name": "zs.purple.zs",
          "match": "(?i)\\b\\w+(?!(apply)\\b)(ly|fold)\\b"
        },
        {
          "name": "zs.orange.zs",
          "match": "(?i)\\b(easy|normal|hard|off|next|constant)\\b"
        },
        {
          "name": "zs.red.zs",
          "match": "(?i)\\b(?!(retry|preUpdateScore|miss|misses|removes?|replaces?|reads?|repr|repeat|resumes?|reverses?|removeprefix|removesuffix|rearranges?|restarts?|overlap|pressed|released|prefix|forced?|precache)\\b)(mis|out|over|pre|re|un)\\w+\\b"
        },
        {
          "name": "zs.blue.zs",
          "match": "(?i)\\b(defeat|victory)\\b"
        },
        {
          "name": "zs.yellow.zs",
          "match": "(?i)\\b(property|sub|dialogue|video|group|method|instance|order|camera|scroll|factor|hitbox|blend|midpoint|graphic|position|pixel|overlap|sprite|animated?|frames?|rate|animation|text|offset|prefix|indices|content|size|width|height|auto|border|color|font|italic|alignment|image|sound|music|fade|volume|timer?|pitch|shader|path|point|flash|clicked|pressed|released|mouse|key|keyboard|gamepad|id|just|button|analog|tag|score|health|rating|percent|fc|running|scripts?|precache|character|atlas|symbol|countdown|difficulty|forced?|offsets?|song|duration)\\b"
        },
        {
          "name": "zs.purple.zs",
          "match": "(?i)\\b(left|right|x|y|z|angle|alpha|direction)\\b"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.zs",
          "begin": "(?i)^\\s*#if\\b",
          "beginCaptures": {
            "0": { "name": "zs.grey.zs" }
          },
          "end": "(?i)^\\s*#end\\b",
          "endCaptures": {
            "0": { "name": "zs.grey.zs" }
          },
          "patterns": [
            {
              "name": "zs.grey.zs",
              "match": "(?i)^\\s*#else if\\b"
            },
            {
              "name": "zs.grey.zs",
              "match": "(?i)^\\s*#else\\b"
            },
            {
              "include": "source.zs"
            }
          ]
        }
      ]
    },
    "prepositions": {
      "patterns": [
        {
          "name": "keyword.preposition.location.zs",
          "match": "(?i)\\b(inside|within|at|on)\\b"
        },
        {
          "name": "keyword.preposition.direction.zs",
          "match": "(?i)\\b(to|into|out|through|across|step)\\b"
        },
        {
          "name": "keyword.preposition.temporal.zs",
          "match": "(?i)\\b(during|until|till|since|between|among)\\b"
        },
        {
          "name": "keyword.preposition.conditional.zs",
          "match": "(?i)\\b(where|without|having|excluding|including)\\b"
        },
        {
          "name": "keyword.preposition.transformation.zs",
          "match": "(?i)\\b(as|using|via|by|through)\\b"
        },
        {
          "name": "keyword.preposition.possession.zs",
          "match": "(?i)\\b(of|or|with|and)\\b"
        },
        {
          "name": "keyword.preposition.comparison.zs",
          "match": "(?i)\\b(than|versus|vs)\\b"
        }
      ]
    },
    "language-type": {
      "patterns": [
        {
          "name": "keyword.other.language-type.zs",
          "match": "^\\!\\s*(ZS-CSHARP|ZS-LUA|ZS-PYTHON|ZS-C|ZS-CPP|ZS-JAVA|ZS-HAXE|ZS-NORMAL)\\b"
        }
      ]
    }
  },
  "uuid": "4d1eb976-65c1-4039-bbc1-97b7eb5d7b2a"
}